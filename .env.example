# ============================================================
#  SoportePost - Plantilla de Variables de Entorno
#  Copia este archivo como .env y rellena con tus valores
#  Este archivo SÍ puede subirse a Git (no tiene datos reales)
# ============================================================

# --- Base de Datos ---
DB_HOSTNAME=127.0.0.1
DB_PORT=5432
DB_USUARIO=postgres
DB_CLAVE=Airan1234
DB_NOMBRE=SoportePost

# --- Directorio de Uploads ---
UPLOAD_BASE_DIR=C:\Documentos_SoportePost\

# --- Integración con SuperApp (descarga autenticada de documentos) ---
# Clave compartida que SuperApp debe enviar en el header X-Service-Key.
# Generar con: php -r "echo bin2hex(random_bytes(32));"  (debe coincidir con
# SOPORTEPOST_SERVICE_KEY en el .env del backend de SuperApp)
# IMPORTANTE: al poner aquí una clave nueva (ej. una distinta para producción),
# copia el mismo valor EXACTO en SOPORTEPOST_SERVICE_KEY del .env de SuperApp,
# y reinicia el backend Node de SuperApp (Apache no necesita reinicio, PHP
# relee el .env en cada request). Si los dos valores no coinciden exactamente,
# SuperApp recibirá 401 "No autorizado" en cada intento de descarga.
SUPERAPP_SERVICE_KEY=genera_una_clave_aleatoria_aqui
# IPs desde las que se acepta esa clave (lista separada por comas).
# Incluir tanto la forma IPv4 como IPv6 del loopback si aplica (127.0.0.1,::1).
SUPERAPP_ALLOWED_IPS=127.0.0.1

# --- Correo SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_AUTH=true
SMTP_USERNAME=tu_correo@dominio.com
SMTP_PASSWORD=tu_app_password_aqui
SMTP_SECURE=tls
SMTP_PORT=587

# --- Depuración (true para desarrollo, false para producción) ---
APP_DEBUG=true
